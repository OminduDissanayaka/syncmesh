PORT=8080
GUN_PEER_URL=http://localhost:8081/gun

CF_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=your_bucket_name

DB_PROVIDER=mongodb
DB_URI=mongodb+srv://user:password@cluster.mongodb.net

# Comma-separated list of allowed frontend origins, e.g.:
#   CORS_ORIGIN=https://app.example.com,https://staging.example.com
# Left empty, ALL cross-origin requests are blocked by default.
CORS_ORIGIN=

# This example's requireAuth stub returns 501 unless this is set — it is
# NOT a real auth bypass safe for anything but local testing. Never set
# this in production.
SKIP_AUTH_FOR_LOCAL_DEV=
